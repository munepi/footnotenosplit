%% This file patches the \@makecol of plcore.ltx so that an "empty"
%% \box\footins (\ht\footins < \footnotesep, i.e. no actual footnote
%% line) is discarded and neither \footnoterule nor \skip\footins is
%% emitted.
%%
\NeedsTeXFormat{pLaTeX2e}
\ProvidesPackage{footnotenosplit-ptex}
  [2026/11/17 v1.1 footnotenosplit implementation for (u)pLaTeX]

\@ifpackageloaded{footnotenosplit}{}{%
  \PackageError{footnotenosplit-ptex}%
    {Do not load this file directly}%
    {Load footnotenosplit.sty instead.}}

\patchcmd{\@makecol}%
  {\ifvoid\footins\else\setbox\@outputbox}%
  {\ifvoid\footins\else
   \ifdim\ht\footins<\footnotesep
     \fns@discard@emptyfootins
   \else\setbox\@outputbox}%
  {\patchcmd{\@makecol}%
     {\let\@textbottom\relax\fi\ifvbox\@kludgeins}%%<= pLaTeX's \@makecol
     {\let\@textbottom\relax\fi\fi\ifvbox\@kludgeins}%
     {}{\fns@warning{Failed to patch \string\@makecol (2)}}}%
  {\fns@warning{Failed to patch \string\@makecol (1)}}

\endinput
